<Window x:Class="L2Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Icon="pack://application:,,,/icon.ico" Width="1000" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2B303A"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="#3A404C"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Fg}"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Background="#2B303A" BorderBrush="#3A404C" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="12,6" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{StaticResource Fg}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#8A6A2E"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Loc[Language]}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ToggleButton Style="{StaticResource LangBtn}" Content="English" IsChecked="{Binding IsEnglish, Mode=TwoWay}" IsEnabled="{Binding NotBusy}"/>
                <ToggleButton Style="{StaticResource LangBtn}" Content="Русский" IsChecked="{Binding IsRussian, Mode=TwoWay}" IsEnabled="{Binding NotBusy}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="{Binding Loc[Server]}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ToggleButton Style="{StaticResource LangBtn}" Content="{Binding Loc[ModeLocal]}" IsChecked="{Binding LocalMode, Mode=OneWay}" IsHitTestVisible="False"/>
                <ToggleButton Style="{StaticResource LangBtn}" Content="{Binding Loc[ModeRemote]}" IsEnabled="{Binding RemoteAvailable}" IsChecked="False"
                              ToolTipService.ShowOnDisabled="True" ToolTip="{Binding Loc[RemoteTip]}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource Muted}" FontSize="11"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding LauncherUpdateVisible, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding LauncherUpdateText}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Btn}" Content="{Binding Loc[U_Update]}" Command="{Binding UpdateLauncherCommand}"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- body -->
        <Grid Grid.Row="1" Margin="0,14,0,10">
            <TabControl Background="{StaticResource Panel}" BorderBrush="#3A404C" Padding="0" IsEnabled="{Binding NotBusy}">
                <TabItem Header="{Binding Loc[T_Server]}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="{Binding Loc[L_Folder]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="{Binding Loc[L_OpenFolder]}" Command="{Binding Local.OpenFolderCommand}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="{Binding Loc[L_Browse]}" Command="{Binding Local.BrowseCommand}"/>
                            <TextBox IsReadOnly="True" Text="{Binding Local.Folder, Mode=OneWay}"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Margin="0,10" FontSize="14" Foreground="{StaticResource Fg}" Text="{Binding Local.StateText}" TextWrapping="Wrap"/>
                        <WrapPanel Grid.Row="2">
                            <Button Style="{StaticResource Btn}" Content="{Binding Loc[L_Start]}" Command="{Binding Local.StartCommand}"/>
                            <Button Style="{StaticResource Btn}" Content="{Binding Loc[L_Stop]}" Command="{Binding Local.StopCommand}"/>
                            <Button Style="{StaticResource Btn}" Content="{Binding Loc[L_Restart]}" Command="{Binding Local.RestartCommand}"/>
                            <Button Style="{StaticResource Btn}" Content="{Binding Loc[L_Refresh]}" Command="{Binding Local.RefreshCommand}"/>
                            <Button Style="{StaticResource Btn}" Content="{Binding Loc[L_Logs]}" Command="{Binding Local.LogsCommand}"/>
                            <Button Style="{StaticResource Btn}" Content="{Binding Loc[L_Install]}" Command="{Binding Local.InstallCommand}"/>
                            <Button Style="{StaticResource Btn}" Content="{Binding Loc[L_SrvVer]}" Command="{Binding Local.ServerVersionCommand}"/>
                            <TextBlock Text="{Binding Local.ServerVersionText}" Foreground="{StaticResource Fg}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
                        </WrapPanel>
                        <CheckBox Grid.Row="3" Margin="0,10" Content="{Binding Loc[L_Autostart]}" IsChecked="{Binding Local.Autostart}"/>
                        <TextBox Grid.Row="4" IsReadOnly="True" Text="{Binding Local.LogsText, Mode=OneWay}" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Background="#111318"/>
                    </Grid>
                </TabItem>
                <TabItem Header="{Binding Loc[T_Rates]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" MaxWidth="640" HorizontalAlignment="Left">
                            <CheckBox Margin="0,4" Content="{Binding Loc[R_Floating]}" IsChecked="{Binding Local.S.FloatingDrop}"/>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.RateXp, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[R_Xp]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.RateSp, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[R_Sp]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.RateAdena, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[R_Adena]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.RateDrop, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[R_Drop]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.RateSpoil, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[R_Spoil]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.RateRaid, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[R_Raid]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.RateQuest, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[R_Quest]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.RateManor, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[R_Manor]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Muted}" Text="{Binding Loc[L_ApplyHint]}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{Binding Loc[T_Char]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" MaxWidth="640" HorizontalAlignment="Left">
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.AutoLearnMaxLevel, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[C_AutoLearn]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <CheckBox Margin="0,4" Content="{Binding Loc[C_Class1]}" IsChecked="{Binding Local.S.ClassChange1}"/>
                            <CheckBox Margin="0,4" Content="{Binding Loc[C_Class2]}" IsChecked="{Binding Local.S.ClassChange2}"/>
                            <CheckBox Margin="0,4" Content="{Binding Loc[C_Class3]}" IsChecked="{Binding Local.S.ClassChange3}"/>
                            <CheckBox Margin="0,4" Content="{Binding Loc[C_Sub]}" IsChecked="{Binding Local.S.SubclassWithoutQuest}"/>
                            <CheckBox Margin="0,4" Content="{Binding Loc[C_Cata]}" IsChecked="{Binding Local.S.OpenCatacombs}"/>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.StartLevel, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[C_StartLevel]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.StartAdena, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[C_StartAdena]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Muted}" Text="{Binding Loc[L_ApplyHint]}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{Binding Loc[T_Bots]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" MaxWidth="640" HorizontalAlignment="Left">
                            <CheckBox Margin="0,4" Content="{Binding Loc[B_Enabled]}" IsChecked="{Binding Local.S.BotsEnabled}"/>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.BotsMax, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[B_Max]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.TownDensity, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[B_Town]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.SpotMax, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[B_Spot]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <CheckBox Margin="0,4" Content="{Binding Loc[B_Pk]}" IsChecked="{Binding Local.S.PkBots}"/>
                            <CheckBox Margin="0,4" Content="{Binding Loc[B_Rb]}" IsChecked="{Binding Local.S.RbParties}"/>
                            <CheckBox Margin="0,4" Content="{Binding Loc[B_Traders]}" IsChecked="{Binding Local.S.Traders}"/>
                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Muted}" Text="{Binding Loc[L_ApplyHint]}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{Binding Loc[T_Game]}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" MaxWidth="640" HorizontalAlignment="Left">
                            <CheckBox Margin="0,4" Content="{Binding Loc[G_BotBuff]}" IsChecked="{Binding Local.S.BotBuffers}"/>
                            <CheckBox Margin="0,4" Content="{Binding Loc[G_CbBuff]}" IsChecked="{Binding Local.S.CommunityBuffer}"/>
                            <CheckBox Margin="0,4" Content="{Binding Loc[G_NpcBuff]}" IsChecked="{Binding Local.S.NpcBuffer}"/>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.BuffDurationMinutes, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[G_BuffMin]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <CheckBox Margin="0,4" Content="{Binding Loc[G_Shop]}" IsChecked="{Binding Local.S.GmShop}"/>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.EnchantMax, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[G_EnchMax]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel Margin="0,3"><TextBox DockPanel.Dock="Right" Width="110" Text="{Binding Local.S.EnchantChance, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding Loc[G_EnchChance]}" Foreground="{StaticResource Fg}" VerticalAlignment="Center"/></DockPanel>
                            <CheckBox Margin="0,4" Content="{Binding Loc[G_Return]}" IsChecked="{Binding Local.S.ReturnSkill}"/>
                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Muted}" Text="{Binding Loc[L_ApplyHint]}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{Binding Loc[T_Admin]}">
                    <DockPanel Margin="12">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Loc[A_Hint]}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Style="{StaticResource Btn}" Content="{Binding Loc[A_Load]}" Command="{Binding Local.LoadCharsCommand}"/>
                            <Button Style="{StaticResource Btn}" Content="{Binding Loc[A_Grant]}" Command="{Binding Local.GrantGmCommand}"/>
                            <Button Style="{StaticResource Btn}" Content="{Binding Loc[A_Revoke]}" Command="{Binding Local.RevokeGmCommand}"/>
                        </WrapPanel>
                        <ListView ItemsSource="{Binding Local.Characters}" SelectedItem="{Binding Local.SelectedCharacter}" Background="#111318" Foreground="#E6E6E6">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Lv" Width="50" DisplayMemberBinding="{Binding Level}"/>
                                    <GridViewColumn Header="Access" Width="70" DisplayMemberBinding="{Binding AccessLevel}"/>
                                    <GridViewColumn Header="Account" Width="150" DisplayMemberBinding="{Binding Account}"/>
                                    <GridViewColumn Header="Online" Width="60" DisplayMemberBinding="{Binding Online}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{Binding Loc[T_Service]}">
                    <StackPanel Margin="12" HorizontalAlignment="Left">
                        <Button Style="{StaticResource Btn}" Margin="0,4" HorizontalAlignment="Left" Content="{Binding Loc[S_Backup]}" Command="{Binding Local.BackupCommand}"/>
                        <Button Style="{StaticResource Btn}" Margin="0,4" HorizontalAlignment="Left" Content="{Binding Loc[S_Restore]}" Command="{Binding Local.RestoreCommand}"/>
                        <Button Style="{StaticResource Btn}" Margin="0,4" HorizontalAlignment="Left" Content="{Binding Loc[S_Reset]}" Command="{Binding Local.ResetCommand}"/>
                        <Button Style="{StaticResource Btn}" Margin="0,4" HorizontalAlignment="Left" Content="{Binding Loc[L_Logs]}" Command="{Binding Local.LogsCommand}"/>
                        <CheckBox Margin="0,10" Content="{Binding Loc[L_Autostart]}" IsChecked="{Binding Local.Autostart}"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
            <ListBox ItemsSource="{Binding Log}" Visibility="{Binding LogVisible, Converter={StaticResource B2V}}"
                     Background="#111318" Foreground="#C8C8C8" BorderThickness="1" BorderBrush="#3A404C" FontFamily="Consolas" FontSize="11"
                     Margin="0,34,0,0" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- status -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="{Binding Status}" FontSize="14" Foreground="{StaticResource Fg}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,6"/>
            <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}"
                         Foreground="{StaticResource Accent}" Background="#2B303A" BorderThickness="0"/>
        </StackPanel>

        <!-- buttons -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="{Binding Loc[L_Apply]}" Command="{Binding Local.ApplyCommand}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="{Binding Loc[Cancel]}" Command="{Binding CancelCommand}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="{Binding Loc[OpenFolder]}" Command="{Binding OpenFolderCommand}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="{Binding Loc[ShowLog]}" Command="{Binding ToggleLogCommand}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource PlayBtn}" Content="{Binding Loc[Play]}" Command="{Binding PlayCommand}"/>
        </DockPanel>
    </Grid>
</Window>
